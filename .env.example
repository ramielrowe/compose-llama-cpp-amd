# Copy to .env and set API_KEY:  cp .env.example .env

# --- build ----------------------------------------------------------------
# llama.cpp tag/branch/SHA. scripts/build.sh resolves it to a SHA first.
LLAMA_REF=b11679
ROCM_IMAGE=docker.io/rocm/dev-ubuntu-26.04:10.1.0-full

# --- network --------------------------------------------------------------
BIND_ADDR=127.0.0.1
PORT=8080
API_KEY=change-me

# --- model ----------------------------------------------------------------
MODEL_FILE=Qwen3.8-27B-UD-IQ4_XS.gguf
MODEL_ALIAS=qwen3.8-27b

# --- context / KV ----------------------------------------------------------
# Native max context. Only the 16 full-attention layers hold KV.
CTX=262144
# K/V types; the pair must be in FA_QUANTS in docker/rocm.Dockerfile.
CTK=q8_0
CTV=q8_0
BATCH=2048
UBATCH=1024
# Host-RAM prompt cache (MiB).
CACHE_RAM_MIB=16384

# --- speculative decoding (empty = off) -------------------------------------
SPEC_ARGS=

# --- sampling: Qwen3.8 model card, thinking mode -----------------------------
TEMP=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0
